# Never expose these as public static files. Follows .gitignore glob syntax.
# The Worker itself keeps working — this only affects the ASSETS binding.

# Git plumbing (huge security leak if served)
.git
.git/**

# Wrangler local state
.wrangler
.wrangler/**
wrangler.jsonc
wrangler.toml

# Source of the Worker (bundled into main, no need to serve)
_worker.js
functions
functions/**

# Node
node_modules
node_modules/**
package.json
package-lock.json

# Repo docs
DEPLOY.md
README.md
*.md

# Server-side data snapshot — served via /api/data instead so sensitive fields are stripped.
data.json

# Meta
.gitignore
.assetsignore
